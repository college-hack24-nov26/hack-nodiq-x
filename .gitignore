# heavy data & generated artifacts
nodiq-x/public/dataset/*
!nodiq-x/public/dataset/micrograph_*.png
apps/web/public/dataset/*
!apps/web/public/dataset/micrograph_*.png
nodiq-x/node_modules/
apps/web/node_modules/
node_modules/
nodiq-x/dist/
apps/web/dist/

# login-loop video ships with the app (only the 480p loop, ~1.4MB; the
# 12MB source master stays local and is referenced nowhere in src/)
nodiq-x/public/videos/*.mp4
!nodiq-x/public/videos/nodiq-login-loop-480p-backup.mp4
apps/web/public/videos/*.mp4
!apps/web/public/videos/nodiq-login-loop-480p-backup.mp4

# SQLite persistence, local backups, logs, archive, and e2e state
server_data/
backups/
!backups/.gitkeep
archive/
!archive/.gitkeep
logs/
!logs/.gitkeep
outputs/
!outputs/.gitkeep
models/
!models/.gitkeep
docker-models/
tools/.e2e_state.json
scripts/tools/.e2e_state.json
scripts/tools/.dsn_fixed

# validated-run outputs: only the summary CSV ships (baked into the Docker
# image for the dataset-browser accuracy lookups); logs/reports stay local
nodularity_1000_fixed/*
!nodularity_1000_fixed/summary_1000_fixed.csv
data/raw/nodularity_1000_fixed/*
!data/raw/nodularity_1000_fixed/summary_1000_fixed.csv
nodularity_report_*/

# legacy experiment archive (4.1GB) — kept on local disk only; the Docker
# image needs just nodularity.py + nodularity_adaptive.py from this folder
Nodularity-main/archive/
Nodularity-main/*
!Nodularity-main/nodularity.py
!Nodularity-main/nodularity_adaptive.py
!Nodularity-main/input_images/
!Nodularity-main/evaluation/
third_party/Nodularity/archive/
third_party/Nodularity/*
!third_party/Nodularity/nodularity.py
!third_party/Nodularity/nodularity_adaptive.py
!third_party/Nodularity/input_images/
!third_party/Nodularity/evaluation/

