# ============================================================================
# NODIQ-X Configuration Template — copy to .env and customize as needed.
# NEVER commit the real .env file. Variables here must remain unpopulated.
#
# NOTE ON DEPLOYMENT & CONTAINERS:
# - docker-compose reads this .env file directly (env_file: ../.env).
# - Inside Docker containers, NODIQ_DATA_DIR MUST be set to /app/server_data
#   so persistent SQLite state, uploads, and session data map to the mounted volume.
# - The backend automatically seeds server-side configuration from .env on startup.
# - Public client variables intended for the React browser bundle MUST start with
#   VITE_ (see the Firebase section below). All other variables are server-only.
# ============================================================================

# ============================================================================
# 1. CORE DIRECTORY & PATH OVERRIDES (nodiq.core.config)
# ============================================================================
# Repository root override (auto-detected if unset)
NODIQ_ROOT=

# Persistent server runtime directory (SQLite DB, uploads, full analysis JSONs)
# REQUIRED in Docker containers: /app/server_data (matches VOLUME ["/app/server_data"])
# Local development default: data/raw/server_data
NODIQ_DATA_DIR=

# Configuration directory (model_capabilities.yaml, presets; default: config/)
NODIQ_CONFIG_DIR=

# Base data directory (default: data/)
NODIQ_DATA_BASE_DIR=

# Raw datasets directory (default: data/raw/)
NODIQ_DATA_RAW_DIR=

# Machine learning model weights directory (default: models/)
NODIQ_MODELS_DIR=

# Analysis outputs, benchmarks, and artifacts (default: outputs/)
NODIQ_OUTPUTS_DIR=

# Documentation directory (default: docs/)
NODIQ_DOCS_DIR=

# Application logs directory (default: logs/)
NODIQ_LOGS_DIR=

# Third-party integrated repositories (default: third_party/)
NODIQ_THIRD_PARTY_DIR=

# Web frontend directory (default: apps/web/)
NODIQ_WEB_DIR=

# Explicit database file path override (default: NODIQ_DATA_DIR/nodiq.db)
NODIQ_DB_PATH=

# Explicit directory for complete analysis JSON payloads (default: NODIQ_DATA_DIR/analyses_full)
NODIQ_FULL_DIR=

# Explicit directory for local artifact image storage (default: NODIQ_DATA_DIR/storage)
NODIQ_LOCAL_STORAGE_DIR=


# ============================================================================
# 2. SERVER & SECURITY HARDENING (nodiq.api.server)
# ============================================================================
# Worker execution mode: 'thread' (in-process with watchdog) or 'child' (isolated subprocess)
NODIQ_EXEC_MODE=

# Maximum /api/analyze requests per IP/user within rate window (default: 30)
NODIQ_ANALYZE_RATE_LIMIT=

# Analysis rate-limit window in seconds (default: 300)
NODIQ_ANALYZE_RATE_WINDOW=

# Maximum concurrent active analyses per authenticated account (default: 2)
NODIQ_ANALYZE_MAX_CONCURRENCY=

# Maximum wall-clock seconds before terminating a runaway analysis job (0 = disabled)
NODIQ_ANALYZE_TIMEOUT=

# Maximum concurrent child worker processes spawned across all accounts (default: 1)
NODIQ_MAX_CHILDREN=

# Enable stderr logging to logs/analysis_child_err.log for child workers (1 = enabled)
NODIQ_CHILD_LOG=

# Trust reverse-proxy X-Forwarded-For and X-Forwarded-Proto headers (true/false)
TRUST_PROXY=false

# Session cookie Secure flag: auto (true over HTTPS/proxy), true, or false
COOKIE_SECURE=auto

# Comma-separated allowed CORS origins for backend API
CORS_ORIGINS=

# Comma-separated trusted origins for CSRF origin verification
CSRF_TRUSTED_ORIGINS=

# SQLite database file for shared rate limiting (default: NODIQ_DATA_DIR/rate_limits.db)
RATE_LIMIT_DB=


# ============================================================================
# 3. PERSISTENCE & DATABASE (Supabase PostgreSQL + Storage vs Local SQLite)
# ============================================================================
# Backend switch: 'sqlite' (local development) or 'supabase' (production PostgreSQL + Storage)
NODIQ_BACKEND=

# Storage backend override: 'local' (filesystem) or 'supabase' (bucket)
NODIQ_STORAGE_BACKEND=

# PostgreSQL connection string (required when NODIQ_BACKEND=supabase; pooler port 6543 recommended)
DATABASE_URL=

# Supabase Project REST URL (e.g. https://xyzcompany.supabase.co)
SUPABASE_URL=

# Supabase Service Role Key (bypasses RLS — server environment only, NEVER client-side)
SUPABASE_SERVICE_ROLE_KEY=

# Supabase Storage bucket for analysis artifacts (default: nodiq-artifacts)
SUPABASE_BUCKET=


# ============================================================================
# 4. AI COPILOT & LLM INTEGRATION (nodiq.ai)
# ============================================================================
# Provider: auto (default failover chain) | groq | gemini | openai | local | fallback
AI_PROVIDER=auto

# Model name for chosen provider (defaults per provider if empty)
AI_MODEL=

# Generic API key for Gemini or OpenAI-compatible endpoints
AI_API_KEY=

# Custom LLM base URL (e.g. http://127.0.0.1:11434/v1 for Ollama, http://127.0.0.1:1234/v1 for LM Studio)
AI_BASE_URL=

# Timeout in seconds for AI completions (default: 25)
AI_TIMEOUT=25

# Force offline rule-based fallback provider (true/false)
OFFLINE_MODE=false

# Groq cloud provider (preferred high-speed primary) — server-only
GROQ_API_KEY=
GROQ_MODEL=

# Groq Key Rotation: backup keys rotated on HTTP 429 rate limits
# Provide comma-separated list or individual indexed entries:
GROQ_API_KEYS=
# GROQ_API_KEY_2=
# GROQ_API_KEY_3=
# GROQ_API_KEY_4=
# GROQ_API_KEY_5=
# GROQ_API_KEY_6=


# ============================================================================
# 5. FEATURE FLAGS (All default to true)
# ============================================================================
ENABLE_COPILOT=true
ENABLE_QUALITY_GATE=true
ENABLE_CALIBRATION=true
ENABLE_BATCH_ANALYTICS=true
ENABLE_SPC=true
ENABLE_ANOMALY_DETECTION=true
ENABLE_AI_REPORTS=true


# ============================================================================
# 6. EMAIL DELIVERY & NOTIFICATIONS (nodiq.services.mailer)
# ============================================================================
# SMTP settings for user feedback, SPC threshold alerts, and password resets
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Recipient address where feedback submissions and SPC alert summaries are delivered
FEEDBACK_TO_EMAIL=


# ============================================================================
# 7. STEEL GRAIN-SIZE ANALYSIS (ASTM E112 / Cellpose-SAM / GSAT)
# ============================================================================
# Path to dedicated virtual environment python hosting cellpose & torch (e.g. /opt/venv-astm/bin/python)
NODIQ_ASTM_PYTHON=

# Directory containing Cellpose-SAM foundation weights (cpsam) or fine-tuned checkpoints
CELLPOSE_LOCAL_MODELS_PATH=

# Custom local checkpoint path (e.g. /app/models/grain_sam_finetuned.pt) or 'cpsam'
NODIQ_ASTM_CHECKPOINT=

# Allow automatic downloading of cpsam weights if not cached on disk (1 = allowed, 0 = require local)
NODIQ_ASTM_ALLOW_DOWNLOAD=

# Inference runner subprocess timeout in seconds (default: 900)
NODIQ_ASTM_TIMEOUT=

# Model initialization test timeout in seconds (default: 300)
NODIQ_ASTM_INIT_TIMEOUT_SECONDS=

# Jeffries planimetric grain count calculation timeout in seconds (default: 120)
NODIQ_ASTM_JEFFRIES_TIMEOUT_SECONDS=


# ============================================================================
# 8. MICROSCOPE CAMERA AGENT (apps/camera-agent)
# ============================================================================
# Loopback HTTP server port for camera capture daemon (default: 8765)
NODIQ_CAMERA_PORT=

# Comma-separated allowed origins for camera daemon CORS (default: http://localhost:5173, http://127.0.0.1:8001)
NODIQ_CAMERA_ALLOWED_ORIGINS=

# Seconds of camera inactivity before closing device handle (default: 15)
NODIQ_CAMERA_IDLE_CLOSE_S=

# Maximum dimension in pixels for preview JPEG stream (default: 1024)
NODIQ_CAMERA_PREVIEW_MAX=

# Verbose debug logging for camera daemon (1 = enabled)
NODIQ_CAMERA_VERBOSE=

# ============================================================================
# 9. DOCKER & WSGI RUNTIME SETTINGS (deploy/Dockerfile)
# ============================================================================
# Gunicorn worker count (default: 1; 1 worker fits 512MB RAM free tier, 2 on paid tiers)
GUNICORN_WORKERS=

# Gunicorn worker threads (default: 4)
GUNICORN_THREADS=

# Batch validation runner: export mask and annotated images to disk (1 = yes, 0 = no)
WITH_FILES=


# ============================================================================
# 10. PUBLIC CLIENT IDENTIFIERS (Firebase Web SDK — apps/web/src/firebase.js)
# ============================================================================
# These variables are bundled directly into the browser Vite SPA bundle at build time.
# They identify the Firebase client project and are public by design.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
